  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dippy"
          }
        ]
      },
      {
        "matcher": "mcp__aws-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/daniel.pendolino/.claude/hooks/aws-role-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path'); [[ \"$f\" == *.md ]] && grip \"$f\" --browser & 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); export SID=$(echo \"$input\" | jq -r '.session_id // \"unknown\"' 2>/dev/null || echo \"unknown\"); export NOTE=\"/Users/daniel.pendolino/Library/CloudStorage/GoogleDrive-daniel.pendolino@ibotta.com/My Drive/Notes/Claude Code Sessions.md\"; python3 -c 'import os,sys,datetime;n=os.environ[\"NOTE\"];sid=os.environ[\"SID\"];s=open(n).read();sys.exit(0) if sid in s else 0;row=\"| `%s` | %s — %s | `%s` | |\"%(sid,datetime.date.today().isoformat(),os.path.basename(os.getcwd()),os.getcwd().replace(os.path.expanduser(\"~\"),\"~\",1));i=s.find(\"\\n## Archive\");k=(s.rindex(\"| `\",0,i) if i>0 else s.rindex(\"| `\"));e=s.index(\"\\n\",k);open(n,\"w\").write(s[:e+1]+row+\"\\n\"+s[e+1:])'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/daniel.pendolino/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh /Users/daniel.pendolino/.claude/statusline-command.sh"
  },
