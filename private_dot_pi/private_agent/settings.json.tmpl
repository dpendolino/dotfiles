{
  "lastChangelogVersion": "1.6.0",
  "defaultProvider": "opencode-go",
  "defaultModel": "hy4-flash-free",
  "defaultThinkingLevel": "medium",
  "shellCommandPrefix": "export PATH=\"$HOME/.local/share/mise/shims:$PATH\"",
  "modelStrategy": {
    "01-brainstorm": "claude-opus-4-7",
    "02-plan": "claude-opus-4-7",
    "03-work": "claude-opus-4-7",
    "04-review": "claude-sonnet-4-6",
    "05-learn": "claude-haiku-4-5",
    "default": "claude-sonnet-4-6"
  },
  "thinkingStrategy": {
    "01-brainstorm": "high",
    "02-plan": "high",
    "03-work": "medium",
    "04-review": "high",
    "05-learn": "medium",
    "default": "high"
  },
  "theme": "terminal",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "followUpMode": "all",
  "steeringMode": "all",
  "markdown": {
    "codeBlockIndent": ""
  },
  "outputPad": 0,
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "resume-hint",
  "images": {
    "autoResize": true
  },
  "terminal": {
    "imageWidthCells": 80
  },
  "httpIdleTimeoutMs": 60000,
  "defaultTools": [
    "+codemode"
  ],
  "npmCommand": [
    "mise",
    "exec",
    "pnpm@12",
    "--",
    "pnpm"
  ],
  "packages": [
    {
      "source": "git:github.com/jeanchristophe13v/pi-rewind@d0afeeee3597e95cdde7e260a7448b780577af1d",
      "extensions": [
        "+rewind.ts"
      ]
    },
    "npm:@dreki-gg/pi-context7@0.2.0",
    {
      "source": "npm:@plannotator/pi-extension@0.28.67",
      "extensions": [
        "-"
      ]
    },
    "git:github.com/elementalvoid/pi-image-tools@56f372fc133b7cd907981c26873022f1e2355f99",
    "npm:pi-mcp-adapter@7.0.1",
    "npm:pi-subagents@0.89.0",
    "npm:pi-tool-display@0.5.0",
    "npm:pi-lens@4.4.6",
    "npm:@ogulcancelik/pi-herdr@0.4.1",
    "npm:@qraxiss/pi-gemini-auth",
    "git:github.com/DietrichGebert/ponytail@7801d061243d7b753bad0e0b3c057cd250b11755",
    "git:github.com/ayghri/i-have-adhd@1ecea1993b7fce257ffbd686c070948b5e07eda6",
{{- if eq .chezmoi.os "darwin" }}
    {
      "source": "git:github.com/Ibotta/pi-extensions@5b1911f7a3092c239c6aa467e420b2ab8f96f7ff",
      "extensions": [
        "!extras/**",
        "+extras/pi-statusline/index.ts",
        "+extras/pi-context/index.ts",
        "+extras/pi-facts/index.ts",
        "+extras/pi-pr/index.ts",
        "+extras/redline/index.ts",
        "+extras/pi-ask/index.ts",
        "+extras/multipi/index.ts"
      ]
    },
    "../../git/ibotta/enablement-platform/skills/internal/workday-reviews",
{{- end }}
    "./local/pi-output-styles-mod"
  ],
  "hideThinkingBlock": false,
  "collapseChangelog": false,
  "quietStartup": false,
  "extensions": [
    "-builtin:mcp",
    "{{ .chezmoi.homeDir }}/.local/share/opencode-console/cli/pi-extension.js"
  ],
  "skills": [
    "-~/.agents/skills/create-pr/SKILL.md"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@dreki-gg/pi-context7@0.2.0\",\"scope\":\"user\"}": "0.2.0",
    "{\"source\":\"git:github.com/elementalvoid/pi-image-tools@56f372fc133b7cd907981c26873022f1e2355f99\",\"scope\":\"user\"}": "1.4.0",
    "{\"source\":\"npm:pi-mcp-adapter@7.0.1\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-subagents@0.89.0\",\"scope\":\"user\"}": "0.89.0",
    "{\"source\":\"npm:pi-tool-display@0.5.0\",\"scope\":\"user\"}": "0.5.0",
    "{\"source\":\"npm:pi-lens@4.4.6\",\"scope\":\"user\"}": "4.4.6",
    "{\"source\":\"npm:@qraxiss/pi-gemini-auth\",\"scope\":\"user\"}": "0.5.1"
  }
}
